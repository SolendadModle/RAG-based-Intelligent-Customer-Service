# Qianwen API Configuration
DASHSCOPE_API_KEY=your_qianwen_api_key_here
QIANWEN_MODEL=qwen-turbo

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# NLU Configuration
NLU_MODEL=en_core_web_sm
INTENT_THRESHOLD=0.7
ENTITY_THRESHOLD=0.6

# Knowledge Base Configuration
KNOWLEDGE_BASE_PATH=./data/knowledge_base
FAQ_FILE=./data/knowledge_base/faq.json

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
CORS_ORIGINS=*

# Redis Configuration (for session management)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging Configuration
LOG_LEVEL=INFO
LOG_PATH=./data/logs

# Sentiment Analysis
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# Recommendation Engine
MAX_RECOMMENDATIONS=5
RECOMMENDATION_THRESHOLD=0.65
